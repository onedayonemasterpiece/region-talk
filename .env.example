# Safe names/defaults only. Never commit real secret values.

REGION_TALK_STATE_BACKEND=kaggle_sqlite
REGION_TALK_CPU_ONLY=1
REGION_TALK_ORCHESTRATOR_ENABLED=0
REGION_TALK_ORCHESTRATOR_INTERVAL_MINUTES=15
REGION_TALK_MAX_CHAIN_HOPS=4
REGION_TALK_TIMEZONE=Europe/Kaliningrad

# Required non-secret owner. Asset refs are derived from it unless overridden.
KAGGLE_USERNAME=

# Derived defaults:
# <KAGGLE_USERNAME>/region-talk-state
# <KAGGLE_USERNAME>/region-talk-run-history
# <KAGGLE_USERNAME>/region-talk-candidate-e5
# <KAGGLE_USERNAME>/region-talk-bge-m3
# <KAGGLE_USERNAME>/region-talk-image-diagnostic
# <KAGGLE_USERNAME>/region-talk-source-profile
# Optional overrides only:
REGION_TALK_STATE_DATASET=
REGION_TALK_RUN_HISTORY_DATASET=
REGION_TALK_KAGGLE_CANDIDATE_KERNEL=
REGION_TALK_KAGGLE_BGE_KERNEL=
REGION_TALK_KAGGLE_IMAGE_KERNEL=
REGION_TALK_KAGGLE_PROFILE_KERNEL=

# Model revisions are pinned in versioned repository config, not runtime env.

REGION_TALK_REVIEW_CHAT_ID=
REGION_TALK_TARGET_CHANNEL_USERNAME=kalinigrad_visit
REGION_TALK_OPERATOR_REVIEWER_IDS=
REGION_TALK_PUBLICATION_SLOTS_LOCAL=11:30,18:30
REGION_TALK_DAILY_ARTICLE_SLOTS=1
REGION_TALK_DAILY_SOCIAL_SLOTS=1
REGION_TALK_VK_PUBLISH_ENABLED=0
REGION_TALK_TELEGRAM_PUBLISH_ENABLED=0

# Existing canonical Google limiter only; no mandatory new control schema.
GOOGLE_AI_ALLOW_RESERVE_FALLBACK=0
GOOGLE_AI_LOCAL_LIMITER_FALLBACK=0
GOOGLE_AI_LOCAL_LIMITER_ON_RESERVE_ERROR=0

REGION_TALK_LOG_RETENTION_DAYS=400
