{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/region-talk/stage-result-v1.schema.json",
  "title": "Region Talk stage result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "stage", "base_state_version",
    "base_state_sha256", "status", "counts", "metrics", "artifacts", "secret_scan"
  ],
  "properties": {
    "schema_version": {"const": "region-talk-stage-result-v1"},
    "run_id": {"type": "string"},
    "stage": {"type": "string"},
    "base_state_version": {"type": "integer", "minimum": 1},
    "base_state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "delta_id": {"type": ["string", "null"]},
    "delta_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["complete", "failed", "blocked", "no_work"]},
    "failure_class": {"type": ["string", "null"]},
    "failure_reason": {"type": ["string", "null"]},
    "zero_progress_reason": {"type": ["string", "null"]},
    "counts": {"type": "object"},
    "metrics": {"type": "object"},
    "artifacts": {"type": "object"},
    "secret_scan": {
      "type": "object",
      "required": ["status"],
      "properties": {"status": {"enum": ["pass", "fail"]}},
      "additionalProperties": true
    },
    "finished_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "complete"}}},
      "then": {"required": ["delta_id", "delta_sha256"]}
    }
  ]
}
